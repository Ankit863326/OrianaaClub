{
  "name": "orianaaclub-backend",
  "version": "1.0.0",
  "private": true,
  "description": "OrianaaClub API backend; Phase 2 provides membership plans and application APIs.",
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "setup:env": "node scripts/setupEnv.js",
    "env:check": "node scripts/envCheck.js",
    "db:check": "node scripts/dbCheck.js",
    "db:repair-legacy-admin-data": "node scripts/repairLegacyAdminData.js",
    "db:migrate:membership-terms": "node scripts/migrateMembershipTermIndexes.js",
    "db:migrate:family-membership": "node scripts/migrateFamilyMembership.js",
    "db:migrate:terms-consents": "node scripts/migrateTermsConsents.js",
    "db:dry-run:member-ids": "node scripts/dryRunMemberCodes.js",
    "seed:plans": "node scripts/seedPlans.js",
    "seed:membership": "node scripts/seedMembership.js",
    "reset:membership-test": "node scripts/resetMembershipTest.js",
    "check:membership-ids": "node scripts/checkMembershipIds.js",
    "seed:admin": "node scripts/seedAdmin.js",
    "dev:unblock-member": "node scripts/unblockMember.js",
    "test:activation": "node scripts/testActivation.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --watch",
    "test:coverage": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --coverage",
    "smoke:test": "node scripts/smokeTest.js",
    "mail:test": "node scripts/testMail.js",
    "points:reconcile": "node scripts/reconcilePoints.js",
    "db:indexes": "node scripts/syncIndexes.js",
    "uploads:migrate": "node scripts/migratePublicMedia.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^7.7.0",
    "mongoose": "^8.13.2",
    "morgan": "^1.12.1",
    "multer": "^2.0.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.1.0",
    "pdfkit": "^0.20.2",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.5",
    "sharp": "^0.34.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.4",
    "nodemon": "^3.1.14",
    "supertest": "^7.1.1"
  }
}
