# Runtime mode; production mode enables secure cookies and strict startup checks.
NODE_ENV=production
# Local HTTP port that the HTTPS reverse proxy forwards requests to.
PORT=5000

# Atlas SRV connection string using the dedicated production user and orianaa_prod database.
MONGO_URI=

# Exact HTTPS website origin allowed by credentialed CORS, with no path.
FRONTEND_URL=https://orianaaclub.com
# Exact HTTPS origin of the independent admin app, with no path.
ADMIN_URL=https://admin.orianaaclub.com
# Public HTTPS API origin used for redirects from plain HTTP requests.
API_URL=https://api.orianaaclub.com
CORS_ORIGINS=https://orianaaclub.com,https://www.orianaaclub.com,https://admin.orianaaclub.com
UPLOAD_DIR=/var/lib/orianaaclub/uploads
MONGOOSE_AUTO_INDEX=false
LOG_LEVEL=info

# Independently generated access-token signing secret; use at least 48 random bytes.
JWT_ACCESS_SECRET=
# Independently generated refresh-token signing secret; do not reuse the access secret.
JWT_REFRESH_SECRET=
# Lifetime of member/admin access tokens, such as 15m.
JWT_ACCESS_EXPIRES_IN=15m
# Lifetime of refresh tokens, such as 7d.
JWT_REFRESH_EXPIRES_IN=7d
# Password-setup-link lifetime in whole days; the standard window is 7 days.
ACTIVATION_TOKEN_DAYS=7
# Password-reset-link lifetime in whole hours; standard reset links last 1 hour.
RESET_TOKEN_HOURS=1
EMAIL_COOLDOWN_SECONDS=60

# Cookie policy; use lax for same-site subdomains or none for cross-site HTTPS apps.
COOKIE_SAMESITE=lax
# Parent domain for sharing cookies among production subdomains.
COOKIE_DOMAIN=.orianaaclub.com

# SMTP server hostname used to send account, enquiry, and payment emails.
SMTP_HOST=
# SMTP server port supplied by the mail provider.
SMTP_PORT=
# SMTP account name or email used for authentication.
SMTP_USER=
# Private SMTP app password or provider credential; must satisfy production secret checks.
SMTP_PASS=
# Sender display name shown on outgoing mail; defaults to OrianaaClub.
MAIL_FROM_NAME=OrianaaClub
# Verified email address shown as the sender; required to send production mail.
MAIL_FROM_ADDRESS=
# Optional address for member replies and the email support footer.
MAIL_REPLY_TO=
# Optional private recipient for manually sending a password-setup template preview with npm run mail:test.
MAIL_TEST_TO=
# Private recipient address for new enquiry notifications.
ADMIN_NOTIFY_EMAIL=

# Public Razorpay live key identifier; must start with rzp_live_.
RAZORPAY_KEY_ID=
# Private Razorpay live API secret; must satisfy production secret checks.
RAZORPAY_KEY_SECRET=
# Private webhook signing secret configured separately in Razorpay.
RAZORPAY_WEBHOOK_SECRET=
# Optional online-payment ceiling in rupees; higher payments must use bank transfer.
RAZORPAY_MAX_ONLINE_RUPEES=

# Private reCAPTCHA secret key for server-side verification.
RECAPTCHA_SECRET_KEY=

# Generate a 64-character key with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IDENTITY_DOCUMENT_ENCRYPTION_KEY=REPLACE_WITH_GENERATED_HEX_KEY

# Bank account name displayed for manual transfers; optional when transfers are disabled.
BANK_ACCOUNT_NAME=
# Bank name displayed for manual transfers.
BANK_NAME=
# Bank account number displayed for manual transfers.
BANK_ACCOUNT_NUMBER=
# Bank IFSC code displayed for manual transfers.
BANK_IFSC=
# Bank branch displayed for manual transfers.
BANK_BRANCH=

# Email of the dedicated first administrator; used only by seed:admin.
ADMIN_EMAIL=sanjaysharma@saptagiriresorts.com
# First name displayed for the seeded administrator.
ADMIN_FIRST_NAME=Sanjay
# Private seed password for the administrator; never log or place in frontend files.
ADMIN_PASSWORD=sanjay@863326

# Explicit confirmation required before production index sync can remove undeclared indexes.
CONFIRM_INDEX_SYNC=
# Sender address placeholder; set this to the approved production sender.
MAIL_FROM=Orianaa Club <no-reply@your-mail-domain>
# Development activation-link display is local-only; never enable it in production.
# Keep draft applications for this many days.
DRAFT_RETENTION_DAYS=14
# Draft-email verification code lifetime in minutes.
DRAFT_OTP_TTL_MINUTES=10
# Minimum resend delay for draft-email verification in seconds.
DRAFT_OTP_RESEND_SECONDS=60
# Maximum verification attempts for a draft email code.
DRAFT_OTP_MAX_ATTEMPTS=5
# Document API rate-limit window in minutes.
DOC_RATE_WINDOW_MINUTES=15
# Maximum document API requests within the rate-limit window.
DOC_RATE_MAX=20
