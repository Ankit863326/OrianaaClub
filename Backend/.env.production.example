NODE_ENV=production
PORT=5000

# Supply real credentials through the deployment secret manager. Encode reserved URI characters.
MONGODB_URI=mongodb://<encoded-user>:<encoded-password>@<database-host>:27017/orianaa_prod?authSource=admin&replicaSet=rs0&retryWrites=true&w=majority
JWT_ACCESS_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_REFRESH_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

FRONTEND_URL=https://orianaaclub.com
ADMIN_URL=https://admin.orianaaclub.com
API_URL=https://api.orianaaclub.com
CORS_ORIGINS=https://orianaaclub.com,https://www.orianaaclub.com,https://admin.orianaaclub.com

ACTIVATION_TOKEN_DAYS=7
RESET_TOKEN_HOURS=1
EMAIL_COOLDOWN_SECONDS=60
DRAFT_RETENTION_DAYS=14
DRAFT_OTP_TTL_MINUTES=10
DRAFT_OTP_RESEND_SECONDS=60
DRAFT_OTP_MAX_ATTEMPTS=5
DOC_RATE_WINDOW_MINUTES=15
DOC_RATE_MAX=20
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=.orianaaclub.com
UPLOAD_DIR=/var/lib/orianaaclub/uploads
MONGOOSE_AUTO_INDEX=false
LOG_LEVEL=info
# Optional absolute path to the deployed agreement files.
TERMS_DIR=

SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=OrianaaClub
MAIL_FROM_ADDRESS=
MAIL_REPLY_TO=
# Optional legacy alias; use a bare email address.
MAIL_FROM=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MAX_ONLINE_RUPEES=
RECAPTCHA_SECRET_KEY=
IDENTITY_DOCUMENT_ENCRYPTION_KEY=REPLACE_WITH_GENERATED_64_CHARACTER_HEX_KEY

ADMIN_NOTIFY_EMAIL=
ADMIN_EMAIL=
ADMIN_FIRST_NAME=
ADMIN_PASSWORD=
MAIL_TEST_TO=
BANK_ACCOUNT_NAME=
BANK_NAME=
BANK_ACCOUNT_NUMBER=
BANK_IFSC=
BANK_BRANCH=
CONFIRM_INDEX_SYNC=

# Optional legacy aliases; prefer MONGODB_URI and API_URL.
MONGO_URI=
API_PUBLIC_URL=
# Optional isolated test database URIs; leave empty in production.
ADMIN_TEST_MONGODB_URI=
ACTIVATION_TEST_MONGODB_URI=
